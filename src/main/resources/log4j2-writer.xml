<?xml version="1.0" encoding="UTF-8"?>
<!--
  入库负载（InsertIntoOracle，主类 com.s1.l2o.Start）的日志配置。

  由 InsertIntoOracle/src/main/resources/log4j2.xml 移植而来，
  顺带修掉原文件的两个路径 bug：
    - fileName="/logs/l2o.log"     写到了磁盘根目录，改为 logs/l2o.log
    - fileName="../logs/error.log" 写到了部署目录的上一级，改为 logs/error-writer.log

  error 日志单独成文件的原因见 log4j2-reader.xml 的说明。
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d [%-5p][%t] %m %throwable{full} (%C:%F:%L) %n"/>
        </Console>

        <RollingFile name="RollingFile" fileName="logs/l2o.log"
                     filePattern="logs/l2o-%d{yyyy-MM-dd}.log" append="true">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] (%l) - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy modulate="true" interval="24"/>
            </Policies>
        </RollingFile>

        <RollingFile name="errorLog" fileName="logs/error-writer.log"
                     filePattern="logs/error-writer-%d{yyyy-MM-dd}.log" append="true">
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] (%l) - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy modulate="true" interval="24"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <Loggers>
        <asyncRoot level="info" includeLocation="true" additivity="true">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="errorLog"/>
        </asyncRoot>
    </Loggers>
</Configuration>
